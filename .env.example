# Provider: tokenfactory (default; required for the hosted demo and published evals) | nvidia (local dev only) | mock (tests/CI)
VOUCH_PROVIDER=tokenfactory
VOUCH_MODE=local            # local | hosted (hosted = per-session caps, simulated outbox only, no outbound HTTP)

# Nebius Token Factory — https://tokenfactory.nebius.com (API keys page)
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA build.nvidia.com free dev key (only used when VOUCH_PROVIDER=nvidia)
NVIDIA_API_KEY=

# Tavily — https://app.tavily.com
TAVILY_API_KEY=

# Optional per-role model overrides (default: auto-discovered from GET /models)
VOUCH_MODEL_CHAT=
VOUCH_MODEL_READER=
VOUCH_MODEL_PLANNER=
VOUCH_MODEL_AUDIT=
VOUCH_MODEL_VL=
VOUCH_MODEL_EMBED=

# Hosted demo: public URL lets Tavily extract the seeded demo pages (optional)
VOUCH_PUBLIC_URL=
VOUCH_DEMO_VIA_TAVILY=false
